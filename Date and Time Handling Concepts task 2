class Solution {
    public String dayOfTheWeek(int day, int month, int year) {

        String[] days = {
            "Sunday",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
        };

        int totalDays = 0;

        // Add days for all complete years
        for (int y = 1971; y < year; y++) {
            if (isLeapYear(y)) {
                totalDays += 366;
            } else {
                totalDays += 365;
            }
        }

        // Days in each month
        int[] daysInMonth = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        // Change February to 29 in a leap year
        if (isLeapYear(year)) {
            daysInMonth[1] = 29;
        }

        // Add days for previous months
        for (int m = 0; m < month - 1; m++) {
            totalDays += daysInMonth[m];
        }

        // Add previous days in current month
        totalDays += day - 1;

        // January 1, 1971 was Friday
        // Friday is index 5
        int dayIndex = (5 + totalDays) % 7;

        return days[dayIndex];
    }

    private boolean isLeapYear(int year) {
        return (year % 400 == 0) ||
               (year % 4 == 0 && year % 100 != 0);
    }
}
