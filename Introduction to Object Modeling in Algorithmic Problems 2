import java.util.*;

class Student {
}

class Rockstar {
}

class Hacker {
}

public class Main {

    static String count(ArrayList myList) {
        int students = 0;
        int rockstars = 0;
        int hackers = 0;

        for (Object student : myList) {
            if (student instanceof Student)
                students++;
            else if (student instanceof Rockstar)
                rockstars++;
            else if (student instanceof Hacker)
                hackers++;
        }

        return students + " " + rockstars + " " + hackers;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayList myList = new ArrayList();

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            String s = sc.next();

            if (s.equals("Student"))
                myList.add(new Student());

            if (s.equals("Rockstar"))
                myList.add(new Rockstar());

            if (s.equals("Hacker"))
                myList.add(new Hacker());
        }

        System.out.println(count(myList));
    }
}
